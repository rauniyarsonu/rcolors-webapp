{
  "name": "rcolors-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "prebuild": "npm run validate:data",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:data": "tsx scripts/estate/validate-data.ts",
    "add-city": "tsx scripts/estate/add-city.ts",
    "add-locality": "tsx scripts/estate/add-locality.ts",
    "import:csv": "tsx scripts/estate/import-csv.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "aos": "^2.3.4",
    "lucide-react": "^1.41.0",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6.30.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aos": "^3.0.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^6.4.4",
    "vitest": "^2.1.9"
  },
  "type": "module"
}
